Package prolixa;

Helpers
    digito = ['0' .. '9'];
    letra_maiuscula = ['A' .. 'Z'];
    letra_minuscula = ['a' .. 'z'];
    letra = (letra_maiuscula | letra_minuscula);

    espaco = 9 | 32; // 9 -> tabulacao
    nova_linha = 10 | 13;

    ascii_char = [32 .. 33] | [35 .. 38] | [40 .. 91] | [93 .. 126];
    comentario_char = [0 .. 124] | [126..127];

    regras = '\' ( 'n' | 't' | 'b' | 'r' | 'a' | ''' | '"' | '?' | '\' | 'f' | 'v' | '0');

    abertura_comentario = '{';
    fechamento_comentario = '}';

Tokens
    comentario = abertura_comentario (comentario_char)* fechamento_comentario;
    this = 'This';
    is = 'is';
    program = 'program';
    it = 'It';
    presents = 'presents';
    let = 'Let';
    us = 'us';
    begin = 'begin';
    that = 'That';
    would = 'would';
    be = 'be';
    all = 'all';

    id = letra_maiuscula+ (letra | '_')*;

    alterable = 'alterable';
    unalterable = 'unalterable';
    vector = 'vector';
    of = 'of';
    x = 'x';
    number = 'number';
    symbol = 'symbol';
    answer = 'answer';
    valor_symbol = ''' (ascii_char | regras | '"') ''';
    string = '"' (ascii_char | regras | ''' | '\')* '"';
    valor_number = digito+ | digito+ '.' digito+;
    valor_answer = 'yes' | 'no';
    capture = 'capture';
    show = 'show';
    just = 'just';
    in = 'in';
    case = 'case';
    that2 = 'that'; // evita conflito com that
    otherwise = 'otherwise';
    do = 'do';
    as = 'as';
    long = 'long';
    considering = 'considering';
    from = 'from';
    to = 'to';
    by = 'by';
    abandon = 'abandon';
    go = 'go';
    next = 'next';
    iteration = 'iteration';
    igual = '=';
    igual_atribuicao = ':=';
    soma = '+';
    subtracao = '-';
    multiplicacao = '*';
    divisao = '/';
    divisao_inteira = '//';
    igual_comparacao = '==';
    nao_igual = '!=';
    menor_igual = '<=';
    maior_igual = '>=';
    menor = '<';
    maior = '>';
    and = 'and';
    or = 'or';
    xor = 'xor';
    nao = '!';
    parenteses_esquerda = '(';
    parenteses_direita = ')';
    colchetes_esquerda = '[';
    colchetes_direita = ']';
    virgula = ',';
    ponto = '.';
    ponto_virgula = ';';
    dois_pontos = ':';
    espacos = espaco+;
    novas_linhas = nova_linha+;

Ignored Tokens
    espacos,
    novas_linhas,
    comentario;

Productions

    programa {-> a_programa} =
        this is program [nome]:id ponto [decl]:declaracoes? [cmds]:comandos?
        {-> New a_programa(nome, decl.a_declaracoes, cmds.a_comandos)};

    declaracoes {-> a_declaracoes} =
        it presents dois_pontos [decls]:declaracao_inicial+
        {-> New a_declaracoes([decls.a_declaracao])};

    comandos {-> a_comandos} =
        let us begin dois_pontos [cmds]:comando+ that would be all ponto
        {-> New a_comandos([cmds.a_comando])};

    declaracao_inicial {-> a_declaracao} =
        {variavel} alterable [tipo]:tipo [nome]:id ponto_virgula
            {-> New a_declaracao.a_var(tipo.a_tipo, nome)} |
        {constante} unalterable [tipo]:tipo [nome]:id [init]:inicializacao_constante? ponto_virgula
            {-> New a_declaracao.a_const(tipo.a_tipo, nome, init.a_exp)} |
        {vetor} vector of [tipo]:tipo parenteses_esquerda [tam]:exp [dims]:dimensoes_vetor? parenteses_direita [nome]:id ponto_virgula
            {-> New a_declaracao.a_vetor(tipo.a_tipo, nome, tam.a_exp, dims.a_exp)};

    declaracao_bloco {-> a_declaracao} =
        {variavel} alterable [tipo]:tipo [nome]:id [init]:inicializacao_varivel? ponto_virgula
            {-> New a_declaracao.a_var_init(tipo.a_tipo, nome, init.a_exp)} |
        {constante} unalterable [tipo]:tipo [nome]:id [init]:inicializacao_constante? ponto_virgula
            {-> New a_declaracao.a_const(tipo.a_tipo, nome, init.a_exp)} |
        {vetor} vector of [tipo]:tipo parenteses_esquerda [tam]:exp [dims]:dimensoes_vetor? parenteses_direita [nome]:id ponto_virgula
            {-> New a_declaracao.a_vetor(tipo.a_tipo, nome, tam.a_exp, dims.a_exp)};

    inicializacao_varivel {-> a_exp} =
        igual_atribuicao [val]:valor {-> val.a_exp};

    inicializacao_constante {-> a_exp} =
        igual [val]:valor {-> val.a_exp};

    dimensoes_vetor {-> a_exp} =
        x [tam]:exp {-> tam.a_exp};

    tipo {-> a_tipo} =
        {number} number {-> New a_tipo.a_number()} |
        {answer} answer {-> New a_tipo.a_answer()} |
        {symbol} symbol {-> New a_tipo.a_symbol()};

    comando {-> a_comando} =
        [cmd]:comando_composto {-> cmd.a_comando};

    comando_composto {-> a_comando} =
        {condicional_simples} just in case that2 parenteses_esquerda [cond]:exp parenteses_direita do [cmd]:comando_composto
            {-> New a_comando.a_if(cond.a_exp, cmd.a_comando)} |
        {laco_while} as long_as parenteses_esquerda [cond]:exp parenteses_direita do [cmd]:comando_composto
            {-> New a_comando.a_while(cond.a_exp, cmd.a_comando)} |
        {laco_for} considering [var]:var from [inicio]:inicio to [fim]:fim by [inc]:incremento do [cmd]:comando_composto
            {-> New a_comando.a_for(var.a_var, inicio.a_exp, fim.a_exp, inc.a_exp, cmd.a_comando)} |
        {comando_simples} [cmd]:comando_simples
            {-> cmd.a_comando};

    comando_simples {-> a_comando} =
        {atribuicao_var} [var]:var igual_atribuicao [exp]:exp ponto_virgula
            {-> New a_comando.a_atrib(var.a_var, exp.a_exp)} |
        {atribuicao_const} [const]:unalt igual [exp]:exp ponto_virgula
            {-> New a_comando.a_atrib_const(const.a_var, exp.a_exp)} |
        {capture} capture parenteses_esquerda [vars]:lista_vars parenteses_direita ponto_virgula
            {-> New a_comando.a_capture(vars.a_lista_vars)} |
        {show} show parenteses_esquerda [exps]:lista_exps parenteses_direita ponto_virgula
            {-> New a_comando.a_show(exps.a_lista_exps)} |
        {abandon} abandon ponto_virgula
            {-> New a_comando.a_abandon()} |
        {continue} go to next iteration ponto_virgula
            {-> New a_comando.a_continue()} |
        {bloco} [blc]:bloco
            {-> blc.a_comando};

    long_as = long as;
    inicio {-> a_exp} = [exp]:exp {-> exp.a_exp};
    fim {-> a_exp} = [exp]:exp {-> exp.a_exp};
    incremento {-> a_exp} = [exp]:exp {-> exp.a_exp};

    else_opcional {-> a_comando} =
        otherwise do [cmd]:comando_composto {-> cmd.a_comando};

    lista_vars {-> a_lista_vars} =
        [primeira]:var [resto]:virgulas_vars*
        {-> New a_lista_vars(primeira.a_var, [resto.a_var])};

    virgulas_vars {-> a_var} =
        virgula [var]:var {-> var.a_var};

    lista_exps {-> a_lista_exps} =
        [primeira]:exp [resto]:virgulas_exps*
        {-> New a_lista_exps(primeira.a_exp, [resto.a_exp])};

    virgulas_exps {-> a_exp} =
        virgula [exp]:exp {-> exp.a_exp};

    bloco {-> a_comando} =
        colchetes_esquerda [decls]:declaracoes_bloco* [cmds]:comandos_bloco* colchetes_direita [else_opt]:else_opcional?
        {-> New a_comando.a_bloco([decls.a_declaracao], [cmds.a_comando], else_opt.a_comando)};

    declaracoes_bloco {-> a_declaracao} =
        [decl]:declaracao_bloco {-> decl.a_declaracao};

    comandos_bloco {-> a_comando} =
        [cmd]:comando {-> cmd.a_comando};

    unalt {-> a_var} =
        [nome]:id {-> New a_var.a_simples(nome)};

    var {-> a_var} =
        {simples} [nome]:id
            {-> New a_var.a_simples(nome)} |
        {indexada} [nome]:id parenteses_esquerda [indice]:exp [outros]:indices_vetor* parenteses_direita
            {-> New a_var.a_indexada(nome, indice.a_exp, [outros.a_exp])};

    indices_vetor {-> a_exp} =
        virgula [exp]:exp {-> exp.a_exp};

    valor {-> a_exp} =
        {symbol} [val]:valor_symbol {-> New a_exp.a_symbol(val)} |
        {answer} [val]:valor_answer {-> New a_exp.a_answer(val)} |
        {number} [val]:valor_number {-> New a_exp.a_number(val)} |
        {string} [val]:string {-> New a_exp.a_string(val)};

    exp {-> a_exp} =
        [exp_ou]:exp_ou {-> exp_ou.a_exp};

    exp_ou {-> a_exp} =
        {ou_logico} [esq]:exp_ou or [dir]:exp_xor
            {-> New a_exp.a_or(esq.a_exp, dir.a_exp)} |
        {exp_xor} [exp_xor]:exp_xor
            {-> exp_xor.a_exp};

    exp_xor {-> a_exp} =
        {ou_exclusivo} [esq]:exp_xor xor [dir]:exp_e
            {-> New a_exp.a_xor(esq.a_exp, dir.a_exp)} |
        {exp_e} [exp_e]:exp_e
            {-> exp_e.a_exp};

    exp_e {-> a_exp} =
        {e_logico} [esq]:exp_e and [dir]:exp_relacional
            {-> New a_exp.a_and(esq.a_exp, dir.a_exp)} |
        {exp_relacional} [exp_relacional]:exp_relacional
            {-> exp_relacional.a_exp};

    exp_relacional {-> a_exp} =
        {igual} [esq]:exp_relacional igual_comparacao [dir]:exp_aditiva
            {-> New a_exp.a_igual(esq.a_exp, dir.a_exp)} |
        {diferente} [esq]:exp_relacional nao_igual [dir]:exp_aditiva
            {-> New a_exp.a_diferente(esq.a_exp, dir.a_exp)} |
        {menor_igual} [esq]:exp_relacional menor_igual [dir]:exp_aditiva
            {-> New a_exp.a_menor_igual(esq.a_exp, dir.a_exp)} |
        {maior_igual} [esq]:exp_relacional maior_igual [dir]:exp_aditiva
            {-> New a_exp.a_maior_igual(esq.a_exp, dir.a_exp)} |
        {menor} [esq]:exp_relacional menor [dir]:exp_aditiva
            {-> New a_exp.a_menor(esq.a_exp, dir.a_exp)} |
        {maior} [esq]:exp_relacional maior [dir]:exp_aditiva
            {-> New a_exp.a_maior(esq.a_exp, dir.a_exp)} |
        {exp_aditiva} [exp_aditiva]:exp_aditiva
            {-> exp_aditiva.a_exp};

    exp_aditiva {-> a_exp} =
        {soma} [esq]:exp_aditiva soma [dir]:exp_multiplicativa
            {-> New a_exp.a_soma(esq.a_exp, dir.a_exp)} |
        {subtracao} [esq]:exp_aditiva subtracao [dir]:exp_multiplicativa
            {-> New a_exp.a_subtracao(esq.a_exp, dir.a_exp)} |
        {exp_multiplicativa} [exp_multiplicativa]:exp_multiplicativa
            {-> exp_multiplicativa.a_exp};

    exp_multiplicativa {-> a_exp} =
        {multiplicacao} [esq]:exp_multiplicativa multiplicacao [dir]:exp_unaria
            {-> New a_exp.a_mult(esq.a_exp, dir.a_exp)} |
        {divisao} [esq]:exp_multiplicativa divisao [dir]:exp_unaria
            {-> New a_exp.a_div(esq.a_exp, dir.a_exp)} |
        {divisao_inteira} [esq]:exp_multiplicativa divisao_inteira [dir]:exp_unaria
            {-> New a_exp.a_div_int(esq.a_exp, dir.a_exp)} |
        {exp_unaria} [exp_unaria]:exp_unaria
            {-> exp_unaria.a_exp};

    exp_unaria {-> a_exp} =
        {menos_unario} subtracao [exp]:exp_unaria
            {-> New a_exp.a_menos_unario(exp.a_exp)} |
        {negacao} nao [exp]:exp_unaria
            {-> New a_exp.a_negacao(exp.a_exp)} |
        {exp_primaria} [exp_primaria]:exp_primaria
            {-> exp_primaria.a_exp};

    exp_primaria {-> a_exp} =
        {valor} [val]:valor
            {-> val.a_exp} |
        {variavel} [var]:var
            {-> New a_exp.a_var(var.a_var)} |
        {parenteses} parenteses_esquerda [exp]:exp parenteses_direita
            {-> exp.a_exp};

Abstract Syntax Tree

    a_programa = [nome]:id [declaracoes]:a_declaracoes? [comandos]:a_comandos?;

    a_declaracoes = [declaracoes]:a_declaracao*;

    a_comandos = [comandos]:a_comando*;

    a_declaracao = {a_var} [tipo]:a_tipo [nome]:id
                 | {a_var_init} [tipo]:a_tipo [nome]:id [init]:a_exp?
                 | {a_const} [tipo]:a_tipo [nome]:id [init]:a_exp?
                 | {a_vetor} [tipo]:a_tipo [nome]:id [tamanho]:a_exp [dimensoes]:a_exp?;

    a_tipo = {a_number}
           | {a_answer}
           | {a_symbol};

    a_comando = {a_if} [condicao]:a_exp [comando]:a_comando
              | {a_while} [condicao]:a_exp [comando]:a_comando
              | {a_for} [variavel]:a_var [inicio]:a_exp [fim]:a_exp [incremento]:a_exp [comando]:a_comando
              | {a_atrib} [variavel]:a_var [expressao]:a_exp
              | {a_atrib_const} [constante]:a_var [expressao]:a_exp
              | {a_capture} [variaveis]:a_lista_vars
              | {a_show} [expressoes]:a_lista_exps
              | {a_abandon}
              | {a_continue}
              | {a_bloco} [declaracoes]:a_declaracao* [comandos]:a_comando* [else_cmd]:a_comando?;

    a_lista_vars = [primeira]:a_var [resto]:a_var*;

    a_lista_exps = [primeira]:a_exp [resto]:a_exp*;

    a_var = {a_simples} [nome]:id
          | {a_indexada} [nome]:id [indice]:a_exp [outros_indices]:a_exp*;

    a_exp = {a_or} [esq]:a_exp [dir]:a_exp
          | {a_xor} [esq]:a_exp [dir]:a_exp
          | {a_and} [esq]:a_exp [dir]:a_exp
          | {a_igual} [esq]:a_exp [dir]:a_exp
          | {a_diferente} [esq]:a_exp [dir]:a_exp
          | {a_menor_igual} [esq]:a_exp [dir]:a_exp
          | {a_maior_igual} [esq]:a_exp [dir]:a_exp
          | {a_menor} [esq]:a_exp [dir]:a_exp
          | {a_maior} [esq]:a_exp [dir]:a_exp
          | {a_soma} [esq]:a_exp [dir]:a_exp
          | {a_subtracao} [esq]:a_exp [dir]:a_exp
          | {a_mult} [esq]:a_exp [dir]:a_exp
          | {a_div} [esq]:a_exp [dir]:a_exp
          | {a_div_int} [esq]:a_exp [dir]:a_exp
          | {a_menos_unario} [exp]:a_exp
          | {a_negacao} [exp]:a_exp
          | {a_var} [variavel]:a_var
          | {a_symbol} valor_symbol
          | {a_answer} valor_answer
          | {a_number} valor_number
          | {a_string} string;